# Seqr mailbox runtime configuration (read by the systemd unit).
SEQR_MAILBOX_BIND=0.0.0.0:8787
SEQR_MAILBOX_DATA=/var/lib/seqr-mailbox
# Accept pull/ack requests whose timestamp is within this many seconds of server time.
SEQR_MAILBOX_SKEW_SECS=120
# Max messages returned per pull (bounded so attachment-chunk responses stay modest).
SEQR_MAILBOX_PULL_LIMIT=16
# Max payload per push (2 MiB: fits one hex-encoded attachment chunk + overhead).
SEQR_MAILBOX_MAX_PAYLOAD=2097152
# Logging.
RUST_LOG=seqr_mailbox=info
